{
  "version": "2.3.2",
  "name": "design-tips",
  "include": ["README.md", "AGENTS.md", "docs/**", "rules/**"],
  "context_files": ["AGENTS.md"],
  "exempt_basenames": ["README.md", "CHANGELOG.md"],
  "link_only_files": ["rules/**"],
  "slugger": "github",
  "summary_policy": "warn",
  "types": ["tutorial", "how-to", "reference", "explanation"],
  "kinds": ["standard", "decision", "index", "note", "glossary", "report", "pitfall"],
  "statuses": ["draft", "active", "resolved", "superseded", "archived"],
  "tiers": ["normal", "critical"],
  "confidences": ["low", "medium", "high"],
  "topics": ["design", "figma", "illustrator", "automation"],
  "relations": {
    "depends-on": {
      "direction": "directed",
      "inverse": "depended-on-by",
      "transitive": false
    },
    "extends": {
      "direction": "directed",
      "inverse": "extended-by",
      "transitive": true
    },
    "spawned-from": {
      "direction": "directed",
      "inverse": "spawned",
      "transitive": false
    },
    "supersedes": {
      "direction": "directed",
      "inverse": "superseded-by",
      "transitive": false
    },
    "contradicts": {
      "direction": "symmetric",
      "inverse": null,
      "transitive": false
    },
    "see-also": {
      "direction": "symmetric",
      "inverse": null,
      "transitive": false
    }
  },
  "review_days": {
    "normal": 365,
    "critical": 90
  },
  "entry_files": ["README.md"],
  "generated_files": [
    "AGENTS.md",
    "llms.txt",
    "docs/_generated/index.md",
    "docs/_generated/backlinks.md",
    "docs/_generated/pitfalls.md"
  ],
  "ignore": [
    ".github/**",
    "tools/**",
    "scripts/**",
    "**/node_modules/**",
    "**/__pycache__/**"
  ]
}
